# API managed en el mismo Static Web App
NEXT_PUBLIC_API_BASE_URL=https://ambitious-island-01ab11110.7.azurestaticapps.net/api

# true = botón AMFS / SSO institucional; false = login demo local
# Nota: el front fuerza login local (isSamlLoginEnabled = false) hasta reactivar SSO.
NEXT_PUBLIC_SAML_LOGIN=false

# --- SAML SP (metadata / npm run saml:metadata) ---
SAML_SP_ENTITY_ID=https://ambitious-island-01ab11110.7.azurestaticapps.net/
SAML_SP_ACS_URL=https://ambitious-island-01ab11110.7.azurestaticapps.net/api/v1/auth/saml/acs
SAML_SP_SLO_URL=https://ambitious-island-01ab11110.7.azurestaticapps.net/api/v1/auth/saml/slo
SAML_SP_AUTHN_REQUESTS_SIGNED=true
SAML_SP_WANT_ASSERTIONS_SIGNED=true
# SAML_SP_PUBLIC_CERT=... (ver certs/saml/sp-public.crt)

# --- SAML IdP AMFS DEVL ---
SAML_IDP_ENTRY_POINT=https://amfsdevl.tec.mx/nidp/saml2/sso
SAML_IDP_SLO_URL=https://amfsdevl.tec.mx/nidp/saml2/slo
# Cert IdP: npm run saml:idp-cert  → certs/saml/idp-public.crt
# SAML_IDP_CERT=...
